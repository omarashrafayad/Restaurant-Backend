# ---------------------------------------------------------------------------
# Take Five backend configuration. Copy to .env and fill in real values.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=5000
NODE_ENV=development            # development | staging | production
BASE_URL=http://localhost:5000  # public URL of this API (used for image links)
CORS_ORIGINS=                   # comma separated, empty = allow all (set it in production!)
TRUST_PROXY=                    # set to 1 when running behind ONE reverse proxy (nginx, Render, Railway...)

# --- Database (MongoDB Atlas or a replica set: transactions are required) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/takefive?retryWrites=true&w=majority
# DNS_SERVERS=8.8.8.8,8.8.4.4   # only if your ISP fails to resolve Atlas SRV records

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Email (password reset codes). Gmail needs an "App password". ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Take Five

# --- Push notifications (Firebase Cloud Messaging) ---
# Either point to the service-account JSON file...
FIREBASE_SERVICE_ACCOUNT_PATH=
# ...or paste its fields (keep the \n in the private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Business ---
RESTAURANT_TIMEZONE=Africa/Cairo

# --- Rate limiting (requests per window per IP) ---
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60

# --- First admin account (used by `npm run seed`) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
