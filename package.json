{
  "name": "restaurant-backend",
  "version": "1.0.0",
  "description": "Take Five restaurant backend (NestJS + MongoDB): ordering, delivery zones, realtime kitchen alerts, push notifications, scheduled offers and sales reports",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "node dist/scripts/seed.js",
    "test:e2e": "nest build && node --test --test-concurrency=1 \"test/e2e/*.test.mjs\""
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.5.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^12.5.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.8",
    "mongoose": "^9.1.5",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/joi": "^17.2.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.9",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
